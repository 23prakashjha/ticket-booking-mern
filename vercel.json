{
  "installCommand": "npm --prefix backend install && npm --prefix frontend install",
  "buildCommand": "node frontend/node_modules/vite/bin/vite.js build --root frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
